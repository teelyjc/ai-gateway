# Base URL of this Next.js app (used by the Axios client for internal API calls)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Auth.js + Authentik OIDC
# Generate with: openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true
# Authentik provider issuer, without .well-known/openid-configuration.
# Example: https://auth.example.com/application/o/ai-gateway/
AUTHENTIK_ISSUER=
AUTHENTIK_CLIENT_ID=
AUTHENTIK_CLIENT_SECRET=
AUTHENTIK_ADMIN_GROUP=ai-gateway-admins

# LiteLLM proxy (management endpoints live at the root, not /v1)
LITELLM_PROXY_URL=http://localhost:4000
# Internal proxy address used for server-to-server calls (bypasses Cloudflare if
# the public URL is fronted by it). Set to the proxy's LAN address, e.g.
# http://litellm:4000 or http://10.x.x.x:4000.
LITELLM_PROXY_INTERNAL_URL=
LITELLM_MASTER_KEY=sk-master-key

# PostgreSQL (shared by LiteLLM proxy + dashboard analytics)
# Postgres in docker-compose is published on host port 5433 (5432 is taken by OrbStack).
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/litellm

# Central provider credentials (held by admin, never exposed to users)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
